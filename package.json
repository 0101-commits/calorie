{
  "name": "protein-radar",
  "version": "2.0.0",
  "description": "외식 프랜차이즈·편의점 메뉴의 단백질 가성비·영양 검증 및 개인 맞춤 추천 서비스",
  "private": true,
  "type": "module",
  "scripts": {
    "pipeline": "node scripts/p0_quarantine.js && node scripts/normalize.js && node scripts/build.js",
    "normalize": "node scripts/normalize.js",
    "build": "node scripts/build.js",
    "site": "node scripts/collect_site.js && node scripts/check_deploy_hygiene.js",
    "test": "node --test tests/*.test.js",
    "serve": "python -m http.server 8080",
    "prices:pending": "node scripts/build_pending_prices.js",
    "prices:entry": "node scripts/price_entry_server.js",
    "prices:merge": "node scripts/merge_pending_prices.js",
    "press": "node scripts/collect_press.js && node scripts/apply_press_prices.js"
  },
  "keywords": [
    "protein",
    "nutrition",
    "calorie",
    "seed-design",
    "radar",
    "cloudflare-d1"
  ],
  "author": "0101-commits",
  "license": "MIT",
  "dependencies": {
    "puppeteer": "^25.11.0"
  }
}
